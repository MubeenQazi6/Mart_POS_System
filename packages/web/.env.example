# ==============================================================================
# MartPOS Web — Environment Configuration Example
# ==============================================================================

# Application Environment: 'development' | 'uat' | 'production'
VITE_APP_ENV=development
VITE_APP_NAME=MartPOS Cloud
VITE_APP_VERSION=1.0.0

# Public Portal URL
VITE_PORTAL_URL=http://localhost:5174

# Supabase Cloud Database & Auth (Multi-Tenant)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional Backend API
VITE_API_URL=

# UAT Private Gatekeeper Passcode (Only active when VITE_APP_ENV=uat)
VITE_UAT_ACCESS_PIN=zenthropic-uat-2026
