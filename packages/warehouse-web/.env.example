# ==============================================================================
# WarehouseOS Web — Environment Configuration Example
# ==============================================================================

VITE_APP_ENV=development
VITE_APP_NAME=WarehouseOS Enterprise Hub
VITE_APP_VERSION=1.0.0

VITE_PORTAL_URL=http://localhost:5175
VITE_API_URL=

# Supabase Cloud Database & Auth (Warehouse Dedicated Isolated Schema/Project)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-warehouse-supabase-anon-key-here

# UAT Private Gatekeeper PIN (active when VITE_APP_ENV=uat)
VITE_UAT_ACCESS_PIN=warehouse-uat-786
